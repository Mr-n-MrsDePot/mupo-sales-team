# ============================================================
# MUPO Sales Team — Environment Configuration
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# --- Primary LLM: xAI Grok (SpaceXAI / api.x.ai) ---
XAI_API_KEY=xai-your-key-here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# --- Fallback LLMs (optional) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FALLBACK_PROVIDER=none
# FALLBACK_PROVIDER options: none | anthropic | openai
FALLBACK_MODEL=claude-3-5-sonnet-latest

# --- Business ---
COMPANY_NAME=MUPO Entertainment
BRAND_NAME=MUPO TV
FOUNDER_NAME=Michele Mupo
SALES_FROM_NAME=MUPO TV Partnerships
SALES_FROM_EMAIL=partnerships@mupotv.example
HUMAN_HANDOFF_EMAIL=michele@mupotv.example
HUMAN_HANDOFF_SLACK_WEBHOOK=

# --- Human-in-the-loop thresholds ---
DEAL_HANDOFF_THRESHOLD_USD=5000
STRONG_SIGNAL_NOTIFY=true

# --- Email delivery ---
# Modes: dry_run | log_only | gmail | instantly | smartlead
EMAIL_MODE=dry_run
# Live send requires EMAIL_ALLOW_LIVE=true AND DRY_RUN=false (both required)
EMAIL_ALLOW_LIVE=false
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=
GMAIL_USER=
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
INSTANTLY_API_BASE=https://api.instantly.ai
SMARTLEAD_API_KEY=
SMARTLEAD_CAMPAIGN_ID=

# --- LinkedIn (placeholder — never auto-send without review) ---
LINKEDIN_MODE=draft_only

# --- Rate limits ---
MAX_OUTREACH_PER_DAY=40
MAX_LLM_CALLS_PER_RUN=50
AGENT_TIMEOUT_SECONDS=120

# --- Paths ---
DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge
CONFIG_PATH=./config/settings.yaml

# --- Runtime ---
LOG_LEVEL=INFO
DRY_RUN=true
ENABLE_VECTOR_MEMORY=false
